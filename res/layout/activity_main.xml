<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_chat">

    <LinearLayout
        android:id="@+id/mainCol"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Chats"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_secondary" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <ImageButton
                android:id="@+id/btnNew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Neuer Chat"
                android:scaleType="centerInside"
                android:src="@drawable/ic_new"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Mehr"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="72dp"
                    android:text="Was kann ich für dich tun?"
                    android:textColor="@color/text_secondary"
                    android:textSize="21sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/attachBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/attachPreview"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_field"
                android:contentDescription="Bildvorschau"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/attachName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Bild angehängt"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnAttachRemove"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Bild entfernen"
                android:scaleType="centerInside"
                android:src="@drawable/ic_stop"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dictBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/dictStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aufnahme läuft"
                android:textColor="@color/danger"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnDictCancel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_ghost"
                android:contentDescription="Aufnahme verwerfen"
                android:scaleType="centerInside"
                android:src="@drawable/ic_stop"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Bild anhängen"
                android:scaleType="centerInside"
                android:src="@drawable/ic_image"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Diktieren"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Sprach-Unterhaltung: reden, Antwort wird vorgelesen"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chat_voice"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:background="@drawable/bg_circle_ghost"
                android:contentDescription="Bildgroesse waehlen"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="832"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:background="@drawable/bg_circle_ghost"
                android:contentDescription="Websuche: antippen schaltet aus oder an"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="Suche aus"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input"
                style="@style/ComposerEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_accent"
                android:contentDescription="Senden"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawerPanel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@color/bg_side"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnDrawerNew"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Neuer Chat"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_new"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/chatScrollDrawer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chatListDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/serverInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnLogout"
                    style="@style/SideItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abmelden"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#88000000" />
    </LinearLayout>
</FrameLayout>
